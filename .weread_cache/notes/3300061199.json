yuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "likesCount": 0}, {"reviewId": "17408780_81TNJg4HW", "review": {"bookId": "3300061199", "content": "这段话太狠了", "bookVersion": 664448110, "range": "13546-13804", "abstract": "那时我就想来着，这些家伙全是江湖骗子，自鸣得意地炫耀几句高深莫测的牛皮大话，博取新入学女孩的好感，随后就把手插到人家裙子里去——想的全是这玩意儿，那号人。一上四年级，就赶紧把头发剪短，忙不迭地钻到什么三菱商社、什么东京广播局、什么IBM公司、什么富士银行找份差事，讨一个压根儿没读过马克思的老婆，挖空心思给孩子取个玄而又玄的名字。至于粉碎产学协同体，简直笑掉眼泪。那些新生也恬不知耻，本来狗屁不懂，却装出大彻大悟的样子，低三下四，事后还居然开导我说：‘你真傻，不懂也说懂不就得了。’喂喂，还有更气人的呢，你听不听？”", "type": 1, "chapterUid": 30, "reviewId": "17408780_81TNJg4HW", "userVid": 17408780, "topics": [], "createTime": 1753412032, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300061199", "format": "epub", "version": 664448110, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/15/cpplatform_mhkuusf5fivqteswxbuuxi/s_cpplatform_mhkuusf5fivqteswxbuuxi1686221024.jpg", "title": "挪威的森林（2023修订版）", "author": "[日]村上春树", "translator": "林少华", "payType": 1048577}, "chapterIdx": 12, "chapterTitle": "第七章", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_81JmIdD2I", "review": {"bookId": "3300061199", "content": "就是太麻烦了，不想被束缚", "bookVersion": 664448110, "range": "25316-25360", "abstract": "“太麻烦了。比如说半夜断烟时那个难受滋味啦，等等。所以戒了。我不情愿被某种东西束缚住。”", "type": 1, "chapterUid": 27, "reviewId": "17408780_81JmIdD2I", "userVid": 17408780, "topics": [], "createTime": 1752819278, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300061199", "format": "epub", "version": 664448110, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/15/cpplatform_mhkuusf5fivqteswxbuuxi/s_cpplatform_mhkuusf5fivqteswxbuuxi1686221024.jpg", "title": "挪威的森林（2023修订版）", "author": "[日]村上春树", "translator": "林少华", "payType": 1048577}, "chapterIdx": 9, "chapterTitle": "第四章", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_81HDaPUwf", "review": {"bookId": "3300061199", "content": "唉……", "bookVersion": 664448110, "range": "10021-10147", "abstract": "永泽时常同别的女孩厮混的事，她基本晓得，但一次也没有口出怨言。她真心真意爱着永泽，却丝毫不加干涉。\n“配我太可惜了！”永泽说。\n我也有同感。", "type": 1, "chapterUid": 26, "reviewId": "17408780_81HDaPUwf", "userVid": 17408780, "topics": [], "flag": 0, "createTime": 1752720758, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300061199", "format": "epub", "version": 664448110, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/15/cpplatform_mhkuusf5fivqteswxbuuxi/s_cpplatform_mhkuusf5fivqteswxbuuxi1686221024.jpg", "title": "挪威的森林（2023修订版）", "author": "[日]村上春树", "translator": "林少华", "payType": 1048577}, "chapterIdx": 8, "chapterTitle": "第三章", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvE