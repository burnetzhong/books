terUid": 23, "reviewId": "17408780_80g8gP9wG", "userVid": 17408780, "topics": [], "createTime": 1747637226, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "22485614", "format": "epub", "version": 91216313, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/48/YueWen_22485614/s_YueWen_22485614.jpg", "title": "1Q84 BOOK 2（7月-9月）", "author": "[日]村上春树", "translator": "施小炜", "payType": 1048577}, "chapterIdx": 23, "chapterTitle": "第21章 青豆 我该怎么办？", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_80g0Wy1IM", "review": {"bookId": "22485614", "content": "哈哈，《1984》的老大哥吗？还是斯大林？", "bookVersion": 85174280, "range": "3371-3513", "abstract": "世界上有资本主义和共产主义两大制度，互相敌视对方。然而双方都隐含深刻的问题，大体上说世界正朝着不好的方向发展。共产主义原本是拥有崇高理想的了不起的思想，可惜被自私的政治家中途扭曲为错误的形态。他们给少女看过一位“自私的政治家”的照片。这个长着大鼻子、留着黑胡须的男人，让她想起了魔王。", "type": 1, "chapterUid": 21, "reviewId": "17408780_80g0Wy1IM", "userVid": 17408780, "topics": [], "createTime": 1747630514, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "22485614", "format": "epub", "version": 91216313, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/48/YueWen_22485614/s_YueWen_22485614.jpg", "title": "1Q84 BOOK 2（7月-9月）", "author": "[日]村上春树", "translator": "施小炜", "payType": 1048577}, "chapterIdx": 21, "chapterTitle": "第19章 青豆 当子体醒来时", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_80fK9tttV", "review": {"bookId": "22485614", "content": "这个回忆的剧情与昨天看的《黑镜第四季》第5集有惊人的相似。", "bookVersion": 85174280, "range": "2904-2980", "abstract": "天吾坐在餐桌前，按照深绘里的暗示，努力回想着青豆的事。\n关于她，有没有几件能回忆起来的事。说不定有用处。", "type": 1, "chapterUid": 20, "reviewId": "17408780_80fK9tttV", "userVid": 17408780, "topics": [], "createTime": 1747615130, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "22485614", "format": "epub", "version": 91216313, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/48/YueWen_22485614/s_YueWen_22485614.jpg", "title": "1Q84 BOOK 2（7月-9月）", "author": "[日]村上春树", "translator": "施小炜", "payType": 1048577}, "chapterIdx": 20, "chapterTitle": "第18章 天吾 沉默而孤独的卫星", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_80bvBgJ7g", "review": {"bookId": "22485614", "content": "“无论如何都要找到她”", "bookVersion": 85174280, "range": "12093-12246", "abstract": "“我终于明白了。她不是概念，不是象征，也不是比喻，而是一个现实的存在，拥有温暖的肉体和跃动的灵魂。而且这温暖和跃动，本该是我不会迷失的东西。可弄懂这样理所当然的事情，我居然花了二十年的时间！我这个人思考问题算时间花得多的，但就算这样，花得也太多了。说不定已经太晚，但我无论如何都想找到她，哪怕现在为时已晚。", "type": 1, "chapterUid": 18, "reviewId": "17408780_80bvBgJ7g", "userVid": 17408780, "topics": [], "createTime": 1747374598, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "22485614", "format": "epub", "version": 91216313, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/48/YueWen_22485614/s_YueWen_22485614.jpg", "title": "1Q84 BOOK 2（7月-9月）", "author": "[日]村上春树", "translator": "施小炜", "payType": 1048577}, "chapterIdx": 18, "chapterTitle": "第16章 天吾 就像一艘幽灵船", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_805RxNyjR", "review": {"bookId": "22485614", "content": "就像《1984》中的温斯顿和茱莉亚。", "bookVersion": 85174280, "range": "15496-15583", "abstract": "男人说：“但准确地说，这并不是单纯的偶然。你们两人的命运并不是自然地在此邂逅，而是命中注定地踏入了这个世界。一旦踏入，不管你们喜不喜欢，你们都将在这个世界中被分别赋予使命。”", "type": 1, "chapterUid": 13, "reviewId": "17408780_805RxNyjR", "userVid": 17408780, "topics": [], "createTime": 1747053901, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "22485614", "format": "epub", "version": 91216313, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/48/YueWen_22485614/s_YueWen_22485614.jpg", "title": "1Q84 BOOK 2（7月-9月）", "author": "[日]村上春树", "translator": "施小炜", "payType": 1048577}, "chapterIdx": 13, "chapterTitle": "第11章 青豆 平衡本身就是善", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true,