ower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_7DuDB1o4C", "review": {"bookId": "932498", "content": "与鲁迅笔下的阿Q在精神层面上类似，不同的是萨特更加强调行动。", "bookVersion": 118164964, "range": "19018-19066", "abstract": "萨特恢复了古代的斯多葛派观念：我或许不能选择我会遭遇什么，但从精神上来说，我可以选择如何看待它。", "type": 1, "chapterUid": 44, "reviewId": "17408780_7DuDB1o4C", "userVid": 17408780, "topics": [], "createTime": 1667463992, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "932498", "format": "epub", "version": 393680825, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/498/932498/s_932498.jpg", "title": "存在主义咖啡馆：自由、存在和杏子鸡尾酒", "author": "莎拉·贝克韦尔", "translator": "沈敏一", "payType": 1048577}, "chapterIdx": 10, "chapterTitle": "第七章 占领，解放", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_7Duz1v4c7", "review": {"bookId": "932498", "content": "可能遗传需要单独讨论，科学已经证明人的性格确实可以通过DNA遗传给下一代，并不是所谓的自欺。", "bookVersion": 118164964, "range": "18138-18223", "abstract": "在萨特看来，只要我们认为自己是被种族、阶级、民族、历史、工作、家庭、遗传、童年影响、事件，甚至是潜藏在我们声称自己无法控制的潜意识中的内驱力所造就的时候，我们就是在自欺。", "type": 1, "chapterUid": 44, "reviewId": "17408780_7Duz1v4c7", "userVid": 17408780, "topics": [], "createTime": 1667459802, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "932498", "format": "epub", "version": 393680825, "soldout": 0