 "17408780_7HR71F6v4", "userVid": 17408780, "topics": [], "createTime": 1682827017, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "26357918", "format": "epub", "version": 1470740042, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/918/26357918/s_26357918.jpg", "title": "海明威短篇小说全集（海明威文集）", "author": "海明威", "translator": "陈良廷,蔡慧", "payType": 4097}, "chapterIdx": 9, "chapterTitle": "弗朗西斯·麦康伯短促的幸福生活", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_7HR6K78hH", "review": {"bookId": "26357918", "content": "双关语", "bookVersion": 411839126, "range": "23247-23270", "abstract": "“干吗不吩咐她留在营地里？”威尔逊对麦康伯说。", "type": 1, "chapterUid": 9, "reviewId": "17408780_7HR6K78hH", "userVid": 17408780, "topics": [], "createTime": 1682826758, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "26357918", "format": "epub", "version": 1470740042, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/918/26357918/s_26357918.jpg", "title": "海明威短篇小说全集（海明威文集）", "author": "海明威", "translator": "陈良廷,蔡慧", "payType": 4097}, "chapterIdx": 9, "chapterTitle": "弗朗西斯·麦康伯短促的幸福生活", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": ""