id": 10, "type": 1, "bookVersion": 411839126, "reviewId": "17408780_7HYWhkSes", "userVid": 17408780, "topics": [], "createTime": 1683271573, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "26357918", "format": "epub", "version": 1470740042, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/918/26357918/s_26357918.jpg", "title": "海明威短篇小说全集（海明威文集）", "author": "海明威", "translator": "陈良廷,蔡慧", "payType": 4097}, "chapterIdx": 10, "chapterTitle": "世界之都", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "commentsCount": 2, "likesCount": 4}, {"reviewId": "17408780_7HYUySZIY", "review": {"bookId": "26357918", "content": "很多职业赚的就是反人性的钱，控制情绪就是一种能力，就可以创造价值。", "bookVersion": 411839126, "range": "10193-10324", "abstract": "“每个人都害怕。不过斗牛士能够抑制住自己心头的害怕，所以他才能撩拨公牛。我参加过一次业余斗牛，结果怕得要死，只好逃走。每个人都认为那很有趣。到时候你也会害怕的。如果不是因为害怕，那西班牙所有擦皮鞋的早就都成了斗牛士了。你，一个乡下小伙子，准会比我怕得还要厉害。”", "type": 1, "chapterUid": 10, "reviewId": "17408780_7HYUySZIY", "userVid": 17408780, "topics": [], "createTime": 1683270000, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "26357918", "format": "epub", "version": 1470740042, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/918/26357918/s_26357918.jpg", "title": "海明威短篇小说全集（海明威文集）", "author": "海明威", "translator": "陈良廷,蔡慧", "payType": 4097}, "chapterIdx": 10, "chapterTitle": "世界之都", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "likesCount": 1}, {"reviewId": "17408780_7HRXt0KPZ", "review": {"bookId": "26357918", "content": "有点像《丧钟为谁而鸣》中的那位斗牛士，游击队员头目，巴布伦。", "bookVersion": 411839126, "range": "2152-2238", "abstract": "这个胆小鬼曾一度勇猛非凡，技艺高强，到斗牛季节他第一次作为正式剑刺手出场时，小肚子就被牛角狠狠地戳了一下，负了重伤，从此便成了胆小鬼，不过仍然保留着走红时的许多豪爽的派头。", "type": 1, "chapterUid": 10, "reviewId": "17408780_7HRXt0KPZ", "userVid": 17408780, "topics": [], "createTime": 1682875060, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "26357918", "format": "epub", "version": 1470740042, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/918/26357918/s_26357918.jpg", "title": "海明威短篇小说全集（海明威文集）", "author": "海明威", "translator": "陈良廷,蔡慧", "payType": 4097}, "chapterIdx": 10, "chapterTitle": "世界之都", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "likesCount": 5}, {"reviewId": "17408780_7HRh5prsH", "review": {"bookId": "26357918", "content": "写得太棒了", "bookVersion": 411839126, "range": "35180-35592", "abstract": "“它已经死在那儿啦，”威尔逊说。“干得好，”接着他转身来抓住麦康伯的手，他们一边握手，一边冲着彼此咧嘴笑着，就在这当儿，那扛枪人发疯似的叫起来，他们看到他斜着身子从灌木丛里跑出来，快得像一只蟹，接着那条公牛出来了，伸出着鼻子，紧闭着嘴，鲜血淋淋，巨大的脑袋笔直向前，一下子猛冲过来，望着他们，那双洼下去的小眼睛里布满了血丝。威尔逊在前面，跪在地上开枪，麦康伯呢，也开火了，但没有听到自己的枪声，因为威尔逊那支枪响声太大了，只看到那犄角间的硕大疣突上迸出板瓦似的碎片，随着这牛头一抽，他瞄准那大鼻子眼又开了一枪，看到一双犄角又猛的晃了一下，碎片飞出来，他现在看不到威尔逊了，眼看这野牛的庞大身子就要扑到身上，他仔细瞄准，又开了一枪，他的来复枪差不多同那颗伸出了鼻子冲上来的牛头一样高低了，他看得见那双恶狠狠的小眼睛，接着这牛头开始搭拉下来，他感到突然有一道白热的、亮得叫人睁不开眼的闪电在他头脑里爆炸，而这就是他的全部感觉了。", "type": 1, "chapterUid": 9, "reviewId": "17408780_7HRh5prsH", "userVid": 17408780, "topics": [], "createTime": 1682836233, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "26357918", "format": "epub", "version": 1470740042, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/918/26357918/s_26357918.jpg", "title": "海明威短篇小说全集（海明威文集）", "author": "海明威", "translator": "陈良廷,蔡慧", "payType": 4097}, "chapterIdx": 9, "chapterTitle": "弗朗西斯·麦康伯短促的幸福生活", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_7HRgLUvfo", "review": {"bookId": "26357918", "content": "害怕自己的丈夫从此变得勇敢，并在其他事情上也一样勇敢。", "bookVersion": 411839126, "range": "33724-33775", "abstract": "“你变得勇敢得很，突然变得勇敢得很，”他的妻子轻蔑地说，但是她的轻蔑是没有把握的。她非常害怕一件事情。", "type": 1, "chapterUid": 9, "reviewId": "17408780_7HRgLUvfo", "userVid": 17408780, "topics": [], "createTime": 1682835945, "userEditTime": 1714705224, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "26357918", "format": "epub", "version": 1470740042, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/918/26357918/s_26357918.jpg", "title": "海明威短篇小说全集（海明威文集）", "author": "海明威", "translator": "陈良廷,蔡慧", "payType": 4097}, "chapterIdx": 9, "chapterTitle": "弗朗西斯·麦康伯短促的幸福生活", "auth