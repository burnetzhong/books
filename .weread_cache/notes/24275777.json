777/s_24275777.jpg", "title": "政治学通识", "author": "包刚升", "payType": 1048577}, "chapterIdx": 40, "chapterTitle": "4.7 国家能力的不同视角", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_7S0AW2L65", "review": {"bookId": "24275777", "content": "国家是否有自主性，谁的自主性，对这个问非常感兴趣", "bookVersion": 1479018387, "range": "1372-1627", "abstract": "尽管如此，国家自主性的概念至今充满争议，这些争议主要来自于两个方面。首先是理性选择学派提出的问题：国家自主性的概念背后有没有微观基础？国家自主性的微观基础是什么？是官僚集团的利益吗？如果不是，那又是什么呢？如果是官僚集团的利益，那么就不是国家本身的利益，也就谈不上国家自主性的概念。这还与另一个重要问题有关，即“几乎没有一个国家是统一的运作者”。比如，对于“国家按照自己的利益行事”这种说法，基欧汉和奈等学者就追问过：“是什么样的自己，是什么利益？”国家主义理论和国家自主性的概念对这些质疑总体上较难有效回应。", "type": 1, "chapterUid": 167, "reviewId": "17408780_7S0AW2L65", "userVid": 17408780, "topics": [], "createTime": 1718581766, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "24275777", "format": "epub", "version": 1479018387, "soldout": 1, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/777/24275777/s_24275777.jpg", "title": "政治学通识", "author": "包刚升", "payType": 1048577}, "chapterIdx": 39, "chapterTitle": "4.6 国家构建与国家能力", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_7RXEy3n6v", "review": {"bookId": "24275777", "content": "秩序是人类生存的根本，所以说人类是逆墒的存在，注定要被宇宙所吞噬，如果热力学第二定律是真理的话。", "bookVersion": 1479018387, "range": "2866-2933", "abstract": "首要的问题不是自由，而是建立一个合法的公共秩序。人当然可以有秩序而无自由，但不能有自由而无秩序。必须先存在权威，而后才谈得上限制权威。", "type": 1, "chapterUid": 162, "reviewId": "17408780_7RXEy3n6v", "userVid": 17408780, "topics": [], "createTime": 1718414675, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "24275777", "format": "epub", "version": 1479018387, "soldout": 1, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/777/24275777/s_24275777.jpg", "title": "政治学通识", "author": "包刚升", "payType": 1048577}, "chapterIdx": 34, "chapterTitle": "4.1 世界版图上的国家", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_7RXCPcV5y", "review": {"bookId": "24275777", "content": "从立国的年份来看，美国还算比较古老的国家了。", "bookVersion": 1479018387, "range": "956-1266", "abstract": "美国政治学家加布里埃尔·阿尔蒙德等人经过统计认为，在美国宣布独立的1776年，按照现代国家的标准，全球只有21个国家；在俄国革命爆发的1917年，世界上只有53个国家；在二战结束的1945年，世界上也只有68个国家；到2002年为止，联合国成员国已经达到191个。由此可见，世界上大部分国家都是二战以后形成的。", "type": 1, "chapterUid": 162, "reviewId": "17408780_7RXCPcV5y", "userVid": 17408780, "topics": [], "createTime": 1718413097, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "24275777", "format": "epub", "version": 1479018387, "soldout": 1, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/777/24275777/s_24275777.jpg", "title": "政治学通识", "author": "包刚升", "payType": 1048577}, "chapterIdx": 34, "chapterTitle": "4.1 世界版图上的国家", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_7RW1kqBeI", "review": {"bookId": "24275777", "content": "不是可能，是一定会成为政府的工具，问题是这种工具说带来的意识形态固化而造成的影响。", "bookVersion": 1479018387, "range": "5220-5323", "abstract": "弗里德曼对大量公共政策问题都有论述，这里仅举一例。比如，他是国家垄断教育的坚定反对者。从政治上讲，教育国有化的一个弊端是政府有可能借助教育控制整个社会的思想和意识形态，所以公立教育系统可能会沦为政府的工具。", "type": 1, "chapterUid": 154, "reviewId": "17408780_7RW1kqBeI", "userVid": 17408780, "topics": [], "createTime": 1718321945, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "24275777", "format": "epub", "version": 1479018387, "soldout": 1, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/777/24275777/s_24275777.jpg", "title": "政治学通识", "author": "包刚升", "payType": 1048577}, "chapterIdx": 26, "chapterTitle": "3.6 新古典自由主义的复兴", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_7RT14UADc", "review": {"bookId": "24275777", "content": "哈耶克的第二推断让我想起来之前比较火的书《为什么伟大不能被计划》，用实际发生的事件证明哈耶克的推断。", "bookVersion": 1479018387, "range": "2604-2865", "abstract": "第二，人是相对无知的，这个社会又需要创新，而创新具有高度的不确定性。因此，一个好的社会要给每一个人及组织以探索和尝试的自由。由于不能事先计划和确定创新来自于何处，自由就为创新所必需。没有此种自由，社会就会慢慢停滞和僵化。当创新不再，经济繁荣和社会进步也成了幻想。所以，哈耶克反对理性建构主义(rational constructuralism)的观点和社会工程(social engineering)的概念。他认为，人类认为可以凭借自己的完全理性与完全信息，把社会推倒并按照自己的意图重新设计一次，这种想法是完全靠不住的。", "type": 1, "chapterUid": 154, "reviewId": "17408780_7RT14UADc", "userVid": 17408780, "topics": [], "createTime": 1718151315, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "24275777", "format": "epub", "version": 1479018387, "soldout": 1, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/777/24275777/s_24275777.jpg", "title": "政治学通识", "author": "包刚升", "payType": 1048577}, "chapterIdx": 26, "chapterTitle": "3.6 新古典自由主义的复兴", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_7RT0UznX6", "review": {"bookId": "24275777", "content": "哈耶克的第一推断如果成立，那么由国家主导的计划经济就是荒谬的。", "bookVersion": 1479018387, "range": "2491-2575", "abstract": "第一，假定有一个中央机构基于理性和科学、依靠其所知的庞大信息来统一做经济决策，是完全靠不住的。理由是该机构所具有的知识和信息，与决策所需的知识和信息相比，还是少得太多。", "type": 1, "chapterUid": 154, "reviewId": "17408780_7RT0UznX6", "userVid": 17408780, "topics": [], "createTime": 1718151162, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "24275777", "format": "epub", "version": 1479018387, "soldout": 1, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/777/24275777/s_24275777.jpg", "title": "政治学通识", "author": "包刚升", "payType": 1048577}, "chapterIdx": 26, "chapterTitle": "3.6 新古典自由主义的复兴", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "commentsCount": 1, "likesCount": 3}, {"reviewId": "17408780_7RKqmAuy4", "review": {"bookId": "24275777", "content": "确实如此", "bookVersion": 1479018387, "range": "6488-6562", "abstract": "第五，值得提醒的是，某种意识形态和这种意识形体的实践往往是两回事。比如，一个国家据说要搞某某主义，而该国最终搞的是不是某某主义，不一定有必然的联系。", "type": 1, "chapterUid": 150, "reviewId": "17408780_7RKqmAuy4", "userVid": 17408780, "topics": [], "createTime": 1717663277, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "24275777", "format": "epub", "version": 1479018387, "soldout": 1, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/777/24275777/s_24275777.jpg", "title": "政治学通识", "author": "包刚升", "payType": 1048577}, "chapterIdx": 22, "chapterTitle": "3.2 现代意识形态的兴起", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "likesCount": 1, "friendLikesCount": 1}, {"reviewId": "17408780_7RAPv6Yur", "review": {"bookId": "24275777", "content": "第二阶段其实古德指的是形而上学阶段，这里念书为玄学，稍有不妥，容易误导读者。", "bookVersion": 1479018387, "range": "492-553", "abstract": "法国哲学家奥古斯特·孔德所著的《实证哲学讲义》把整个人类对重要问题的思考分成三个阶段，分别是神学阶段、玄学阶段和科学阶段。", "type": 1, "chapterUid": 145, "reviewId": "17408780_7RAPv6Yur", "userVid": 17408780, "topics": [], "createTime": 1717118304, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "24275777", "format": "epub", "version": 1479018387, "soldout": 1, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/777/24275777/s_24275777.jpg", "title": "政治学通识", "author": "包刚升", "payType": 1048577}, "chapterIdx": 17, "chapterTitle": "2.5 经验研究范式的兴起", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "commentsCount": 0, "likesCount": 3}, {"reviewId": "17408780_7RANWRktE", "review": {"bookId": "24275777", "content": "以卢梭当时所处的环境，以及他所处的贫穷环境，不难理解他的这种思想。", "bookVersion": 1479018387, "range": "6584-6644", "abstract": "在此基础上，卢梭进一步阐明了主权在民原则。卢梭所谓的“主权者”，是指合法性源自人民，而非源自君主、贵族或任何的少部分人。", "type": 1, "chapterUid": 144, "reviewId": "17408780_7RANWRktE", "userVid": 17408780, "topics": [], "createTime": 1717116882, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "24275777", "format": "epub", "version": 1479018387, "soldout": 1, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/777/24275777/s_24275777.jpg", "title": "政治学通识", "author": "包刚升", "payType": 1048577}, "chapterIdx": 16, "chapterTitle": "2.4 从“黑暗时代”到启蒙时代", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "likesCount": 1}, {"reviewId": "17408780_7RyhIruiE", "review": {"bookId": "24275777", "content": "柏拉图在理想国中的观点非常不民主，甚至不允许言论自由。", "bookVersion": 1479018387, "range": "4199-4215", "abstract": "由此可见，柏拉图并非民主的朋友。", "type": 1, "chapterUid": 143, "reviewId": "17408780_7RyhIruiE", "userVid": 17408780, "topics": [], "createTime": 1716973752, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "24275777", "format": "epub", "version": 1479018387, "soldout": 1, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/777/24275777/s_24275777.jpg", "title": "政治学通识", "author": "包刚升", "payType": 1048577}, "chapterIdx": 15, "chapterTitle": "2.3 古希腊与古罗马的传统", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_7RubQWb6V", "review": {"bookId": "24275777", "content": "法理也不能保证任何事情，甚至连底线都不能守住，因为宪法是可以改的，人类政治很可悲。", "bookVersion": 1479018387, "range": "7667-7768", "abstract": "所以，基本的法要优先于统治本身，基本的法要优先于统治者本身。这种传统过去被称为“立宪主义”。我们首先要明确基本规则，明确统治者和统治机构能够做什么和不能做什么，然后再来讨论谁来统治和具体如何统治的问题。", "type": 1, "chapterUid": 141, "reviewId": "17408780_7RubQWb6V", "userVid": 17408780, "topics": [], "createTime": 1716741180, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "24275777", "format": "epub", "version": 1479018387, "soldout": 1, "bookStatus": 1, "type": 0, "cover": "https://wfqqreader-1252317822.image.myqcloud.com/cover/777/24275777/s_24275777.jpg", "title": "政治学通识", "author": "包刚升", "payType": 1048577}, "chapterIdx": 13, "chapterTitle": "2.1 岛屿的寓言：谁之统治？何种秩序？", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}], "totalCount": 13}}