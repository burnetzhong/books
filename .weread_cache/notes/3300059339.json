ount": 2}, {"reviewId": "17408780_7MiwejC8G", "review": {"bookId": "3300059339", "content": "广告法中已经明确规定，不允许这么宣传产品，鉴于此书写作时间，情有可原。", "bookVersion": 526223200, "range": "1243-1317", "abstract": "所以，它确实没有被其他品牌超越，但是当然，它也没有超越其他任何品牌。这个著名的阿司匹林品牌非常畅销，尽管其售价是同样有效但没那么耳熟能详的品牌的五倍", "type": 1, "chapterUid": 10, "reviewId": "17408780_7MiwejC8G", "userVid": 17408780, "topics": [], "createTime": 1698470172, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300059339", "format": "epub", "version": 1014374135, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/86/cpplatform_5szrgm7fyvfnsghlvctj1m/s_cpplatform_5szrgm7fyvfnsghlvctj1m1684718930.jpg", "title": "认知操纵：宣传如何影响我们的思想和行为（修订版）", "author": "安东尼·普拉卡尼斯  埃利奥特·阿伦森", "translator": "阮江平", "payType": 1048577}, "chapterIdx": 10, "chapterTitle": "第三部分 预劝导：为有效影响他人搭建舞台", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "likesCount": 2}, {"reviewId": "17408780_7MhJUhSJN", "review": {"bookId": "3300059339", "content": "这个道理对于中国人很容易理解，想想每天的新闻联播，再看看中央13频道的新闻，就可以看到全世界最形象生动的propaganda.", "bookVersion": 526223200, "range": "15769-15841", "abstract": "成功的劝导策略可以指导和引领受众的想法，令其以与传播者观点一致的方式思考；针对传播者建议的行为，成功的劝导策略会阻断一切负面想法，促进正面想法。", "type": 1, "chapterUid": 6, "reviewId": "17408780_7MhJUhSJN", "userVid": 17408780, "topics": [], "createTime": 1698425902, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300059339", "format": "epub", "version": 1014374135, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/86/cpplatform_5szrgm7fyvfnsghlvctj1m/s_cpplatform_5szrgm7fyvfnsghlvctj1m1684718930.jpg", "title": "认知操纵：宣传如何影响我们的思想和行为（修订版）", "author": "安东尼·普拉卡尼斯  埃利奥特·阿伦森", "translator": "阮江平", "payType": 1048577}, "chapterIdx": 6, "chapterTitle": "第二部分 日常劝导中的心理学", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "commentsCount": 2, "likesCount": 1}, {"reviewId": "17408780_7MgJAtxsb", "review": {"bookId": "3300059339", "content": "有点异想天开吧，精神分析真的不靠谱。", "bookVersion": 526223200, "range": "7339-7408", "abstract": "一旦事物的潜意识含义被发掘出来，广告商就能设计一场宣传战，它可以唤醒我们心底最深的动力，从而击溃我们的防线；至少精神分析理论是这么认为的。", "type": 1, "chapterUid": 6, "reviewId": "17408780_7MgJAtxsb", "userVid": 17408780, "topics": [], "createTime": 1698368809, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300059339", "format": "epub", "version": 1014374135, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/86/cpplatform_5szrgm7fyvfnsghlvctj1m/s_cpplatform_5szrgm7fyvfnsghlvctj1m1684718930.jpg", "title": "认知操纵：宣传如何影响我们的思想和行为（修订版）", "author": "安东尼·普拉卡尼斯  埃利奥特·阿伦森", "translator": "阮江平", "payType": 1048577}, "chapterIdx": 6, "chapterTitle": "第二部分 日常劝导中的心理学", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "commentsCount": 1, "likesCount": 1}, {"reviewId": "17408780_7Mg76gP7l", "review": {"bookId": "3300059339", "content": "熟人社会就会抵御大众媒体的宣传吗？第一次看到这种观点，很值得思考，暂时保留意见。", "bookVersion": 526223200, "range": "4002-4332", "abstract": "有人担心，个体因为切断了与其社会根源的联系，一切资讯的获得都将依赖大众媒体以及特定领袖，因此对于宣传将毫无防御能力。用某些人的话来形容，大众媒体可以发射信息“魔弹”，随心所欲地塑造民意，左右公众看法。", "type": 1, "chapterUid": 6, "reviewId": "17408780_7Mg76gP7l", "userVid": 17408780, "topics": [], "createTime": 1698333549, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300059339", "format": "epub", "version": 1014374135, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/86/cpplatform_5szrgm7fyvfnsghlvctj1m/s_cpplatform_5szrgm7fyvfnsghlvctj1m1684718930.jpg", "title": "认知操纵：宣传如何影响我们的思想和行为（修订版）", "author": "安东尼·普拉卡尼斯  埃利奥特·阿伦森", "translator": "阮江平", "payType": 1048577}, "chapterIdx": 6, "chapterTitle": "第二部分 日常劝导中的心理学", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "commentsCount": 3, "likesCount": 1}, {"reviewId": "17408780_7McMbUD97", "review": {"bookId": "3300059339", "content": "这么看来，所谓的短视频其实并不短。", "bookVersion": 526223200, "range": "16073-16170", "abstract": "如今，电视中播放的政治广告通常持续30秒或者更短。杂志上的广告往往只有一张图片加上短短的一句话。今日新闻以简短的“原声摘要”和“新闻片段”出现。举个例子，70%的本地电视新闻的长度不超过一分钟。", "type": 1, "chapterUid": 5, "reviewId": "17408780_7McMbUD97", "userVid": 17408780, "topics": [], "createTime": 1698143993, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300059339", "format": "epub", "version": 1014374135, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/86/cpplatform_5szrgm7fyvfnsghlvctj1m/s_cpplatform_5szrgm7fyvfnsghlvctj1m1684718930.jpg", "title": "认知操纵：宣传如何影响我们的思想和行为（修订版）", "author": "安东尼·普拉卡尼斯  埃利奥特·阿伦森", "translator": "阮江平", "payType": 1048577}, "chapterIdx": 5, "chapterTitle": "第一部分 我们这个宣传的时代", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_7McM7KNcc", "review": {"bookId": "3300059339", "content": "如果把短视频也算作一种宣传，一种广告，那么一个人一辈子看到数量将是这个的几十倍。", "bookVersion": 526223200, "range": "15553-15739", "abstract": "我们生活在一个信息密集的环境。营销大师阿尔·里斯(Al Ries)和杰克·特劳特(Jack Trout)称我们的社会是“过度传播”的社会。一个普通的美国人，一生会看到或听到700多万个广告。", "type": 1, "chapterUid": 5, "reviewId": "17408780_7McM7KNcc", "userVid": 17408780, "topics": [], "createTime": 1698143932, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300059339", "format": "epub", "version": 1014374135, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/86/cpplatform_5szrgm7fyvfnsghlvctj1m/s_cpplatform_5szrgm7fyvfnsghlvctj1m1684718930.jpg", "title": "认知操纵：宣传如何影响我们的思想和行为（修订版）", "author": "安东尼·普拉卡尼斯  埃利奥特·阿伦森", "translator": "阮江平", "payType": 1048577}, "chapterIdx": 5, "chapterTitle": "第一部分 我们这个宣传的时代", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy"