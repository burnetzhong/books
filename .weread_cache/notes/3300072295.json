6580"}, "chapterIdx": 14, "chapterTitle": "第十二章", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "likesCount": 1}, {"reviewId": "17408780_7NDWirJ5m", "review": {"bookId": "3300072295", "content": "虎力大仙像极了研发RD们。", "bookVersion": 879935361, "range": "5083-5254", "abstract": "虎力大仙为难道：“新旧簿子现在纠缠一处，阴阳交错，难以拆分，查起来牵涉不小。”秦广王不悦道：“且不管新的如何，难道旧簿子如今都不能查了？你们是干什么吃的？”虎力大仙不卑不亢：“贵府生死簿从不备贰，既无注解备考可参，又无更新记录可查，层累堆积，庞杂繁复，如今已呈混沌之相，牵一发而动全身。我等法力浅薄，只能做简单修补，一旦触及根本，后果难测。”", "type": 1, "chapterUid": 48, "reviewId": "17408780_7NDWirJ5m", "userVid": 17408780, "topics": [], "createTime": 1703208472, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300072295", "format": "epub", "version": 1961481859, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/72/cpplatform_huhykqamxcvke1jfkpqxiv/s_cpplatform_huhykqamxcvke1jfkpqxiv1695711014.jpg", "title": "太白金星有点烦", "author": "马伯庸", "payType": 1048577, "authorSeg": [{"words": "马伯庸", "highlight": 1, "authorId": "158711", "authorVid": 282476580}], "authorVids": "282476580"}, "chapterIdx": 14, "chapterTitle": "第十二章", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞