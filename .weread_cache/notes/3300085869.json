2wt1ca1706772686.jpg", "title": "控糖革命", "author": "[法]杰西·安佐斯佩", "translator": "张艳娟 ", "payType": 1048577}, "bookFinderSuccessCount": 0, "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_85nLGwCvJ", "review": {"bookId": "3300085869", "content": "以后每天午饭前我要吃公司的胡萝卜零食。", "bookVersion": 340748515, "range": "5100-5261", "abstract": "让我们再来回顾一下杰斯采用新的饮食方式后，她的血糖波动情况。现在，杰斯每天晚餐前都会加一份阿拉伯蔬菜沙拉（作为餐前小菜），然后和原来一样吃一碗意大利面。这个微小的调整，让她的身体出现了一些不一样的情况：葡萄糖的输送速度从急速变得缓慢。葡萄糖峰值变得没有之前明显，随之而来的血糖下降幅度也变小了（见图3-19和图3-20）。", "type": 1, "chapterUid": 18, "chapterName": "9 窍门2 在每餐前增加一道绿色开胃菜", "chapterIdx": 18, "reviewId": "17408780_85nLGwCvJ", "userVid": 17408780, "topics": [], "createTime": 1765679010, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300085869", "format": "epub", "version": 1189030751, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/64/cpplatform_qpqefbrrjjgqq7t62wt1ca/s_cpplatform_qpqefbrrjjgqq7t62wt1ca1706772686.jpg", "title": "控糖革命", "author": "[法]杰西·安佐斯佩", "translator": "张艳娟 ", "payType": 1048577}, "chapterTitle": "9 窍门2 在每餐前增加一道绿色开胃菜", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_85jx0nop9", "review": {"bookId": "3300085869", "content": "人类发明了蔗糖的提纯，而不是发明了糖。", "bookVersion": 340748515, "range": "3337-3388", "abstract": "再之后，人类通过煮沸甘蔗并使其汁液结晶，创造出了食用糖——100%蔗糖。这款新产品在18世纪风靡世界。", "type": 1, "chapterUid": 11, "chapterName": "4 寻求快乐 为什么我们比原来吃了更多的葡萄糖", "chapterIdx": 11, "reviewId": "17408780_85jx0nop9", "userVid": 17408780, "topics": [], "createTime": 1765438360, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300085869", "format": "epub", "version": 1189030751, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/64/cpplatform_qpqefbrrjjgqq7t62wt1ca/s_cpplatform_qpqefbrrjjgqq7t62wt1ca1706772686.jpg", "title": "控糖革命", "author": "[法]杰西·安佐斯佩", "translator": "张艳娟 ", "payType": 1048577}, "chapterTitle": "4 寻求快乐 为什么我们比原来吃了更多的葡萄糖", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}], "totalCount": 3}}