, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_84NzQIrnh", "review": {"bookId": "3300061198", "content": "村上明显不懂加密算法，非对称加密早就取代对称加密算法了", "bookVersion": 1784541452, "range": "5410-5461", "abstract": "暗号中信赖度最高的，是书对书系统，即互发暗号的两个人具有同一版的同一本书、以页数和行数决定单词的系统。", "type": 1, "chapterUid": 30, "chapterName": "25 冷酷仙境——吃喝、象厂、圈套", "chapterIdx": 30, "reviewId": "17408780_84NzQIrnh", "userVid": 17408780, "topics": [], "createTime": 1763623358, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300061198", "format": "epub", "version": 1784541452, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/31/cpplatform_b9m7ngdc5bxl9141zcgx9x/s_cpplatform_b9m7ngdc5bxl9141zcgx9x1686221012.jpg", "title": "世界尽头与冷酷仙境（2023修订版）", "author": "[日]村上春树", "translator": "林少华", "payType": 1048577}, "chapterTitle": "25 冷酷仙境——吃喝、象厂、圈套", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}, "likesCount": 1}, {"reviewId": "17408780_84p4jOw1w", "review": {"bookId": "3300061198", "content": "冷酷仙境中存在大量食物，衣物以及现实物体的描写；而世界尽头更多的是内心感受与自然。", "bookVersion": 1784541452, "range": "740-852", "abstract": "为了不刺激伤口，我小心翼翼地把两腿插进牛仔裤，在T恤外面套上运动衫，并加了一件薄毛衣。出于慎重，我又打开衣箱，拿出登山用尼龙防寒衣。女郎那套粉红色西装裙看上去无论如何都不适于地下探险，遗憾的是我衣箱里又没有适合她体型的衣裤。", "type": 1, "chapterUid": 24, "chapterName": "19 冷酷仙境——汉堡包、天际线、截止期限", "chapterIdx": 24, "reviewId": "17408780_84p4jOw1w", "userVid": 17408780, "topics": [], "createTime": 1762231266, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300061198", "format": "epub", "version": 1784541452, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/31/cpplatform_b9m7ngdc5bxl9141zcgx9x/s_cpplatform_b9m7ngdc5bxl9141zcgx9x1686221012.jpg", "title": "世界尽头与冷酷仙境（2023修订版）", "author": "[日]村上春树", "translator": "林少华", "payType": 1048577}, "chapterTitle": "19 冷酷仙境——汉堡包、天际线、截止期限", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_83XkXawkh", "review": {"bookId": "3300061198", "content": "我要买个好沙发", "bookVersion": 1784541452, "range": "1148-1298", "abstract": "我知道好几个人虽然坐着高级轿车往来奔波而家里放的却是二三流的沙发，对这样的人我是不大信任的。高级车或许不失其应有的价值，但终归不过是高级车而已，只要花钱谁都能手到擒来。而买好沙发则需要相应的见识、经验和哲学。钱固然要花，但并非只消花钱即可。就沙发而言，头脑中若没有一个完整的形象，是不可能得到好货的。", "type": 1, "chapterUid": 10, "chapterName": "5 冷酷仙境——计算、进化、性欲", "chapterIdx": 10, "reviewId": "17408780_83XkXawkh", "userVid": 17408780, "topics": [], "createTime": 1760656099, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300061198", "format": "epub", "version": 1784541452, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/31/cpplatform_b9m7ngdc5bxl9141zcgx9x/s_cpplatform_b9m7ngdc5bxl9141zcgx9x1686221012.jpg", "title": "世界尽头与冷酷仙境（2023修订版）", "author": "[日]村上春树", "translator": "林少华", "payType": 1048577}, "chapterTitle": "5 冷酷仙境——计算、进化、性欲", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}, {"reviewId": "17408780_83VjAhuQt", "review": {"bookId": "3300061198", "content": "简单的说就是加密和解密，图灵可能是符号士的头儿。", "bookVersion": 1784541452, "range": "13307-13552", "abstract": "总之，只有使图中犬牙交错的断面正相吻合，才能将得出的数值复原。然而符号士们企图通过架假设桥的办法来解读其从计算机上窃来的数值。就是说，他们通过分析数值将犬牙交错的情形在全息图上再现出来。这样做有时顺利有时不顺利。若我们提高技术，他们也提高对抗技术。我们保护数据，他们盗窃数据——纯属古典式警察和小偷的套数。\n符号士们将非法获取的数据大多捅到黑市上去，牟取暴利。更糟糕的是，他们将情报最重要的部分掌握在自己手中，有效地为自己的组织服务。", "type": 1, "chapterUid": 8, "chapterName": "3 冷酷仙境——雨衣、夜鬼、分类运算", "chapterIdx": 8, "reviewId": "17408780_83VjAhuQt", "userVid": 17408780, "topics": [], "createTime": 1760541245, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300061198", "format": "epub", "version": 1784541452, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/31/cpplatform_b9m7ngdc5bxl9141zcgx9x/s_cpplatform_b9m7ngdc5bxl9141zcgx9x1686221012.jpg", "title": "世界尽头与冷酷仙境（2023修订版）", "author": "[日]村上春树", "translator": "林少华", "payType": 1048577}, "chapterTitle": "3 冷酷仙境——雨衣、夜鬼、分类运算", "author": {"userVid": 17408780, "name": "钟涵", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/1OfJCYwoJtaLU1wLBu3bTrBODSyuW89Q3VtvETqKuY4TKP83GoRQwpFiaibK7yicKS9fSOicARg2zvEv2aicibgafxxgj1xibWicLjSLbicqiaaFm0H7M/132", "isFollowing": 1, "isFollower": 1, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M6-0-1000", "desc": "收到的赞", "title": "收到的赞", "levelIndex": 1000}}}}], "totalCount": 12}}