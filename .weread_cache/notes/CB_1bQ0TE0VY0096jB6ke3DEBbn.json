{"bookId": "CB_1bQ0TE0VY0096jB6ke3DEBbn", "title": "The Psychology of Money: Timeless Lessons on Wealth, Greed, and Happiness", "bookmarks": {"synckey": 1703387046, "updated": [{"bookId": "CB_1bQ0TE0VY0096jB6ke3DEBbn", "bookmarkId": "CB_1bQ0TE0VY0096jB6ke3DEBbn_3_29737-29995", "createTime": 1703302034, "range": "29737-29995", "markText": "We all do crazy stuff with money, because we’re all relatively new to this game and what looks crazy to you might make sense to me. But no one is crazy—we all make decisions based on our own unique experiences that seem to make sense to us in a given moment.", "colorStyle": 3, "type": 1, "chapterUid": 3}, {"bookId": "CB_1bQ0TE0VY0096jB6ke3DEBbn", "bookmarkId": "CB_1bQ0TE0VY0096jB6ke3DEBbn_3_18528-18699", "createTime": 1703301760, "range": "18528-18699", "markText": "Every decision people make with money is justified by taking the information they have at the moment and plugging it into their unique mental model of how the world works.", "colorStyle": 3, "type": 1, "chapterUid": 3}], "removed": [], "chapters": [{"title": "1. No One’s Crazy", "chapterUid": 3, "chapterIdx": 3}], "book": {"bookId": "CB_1bQ0TE0VY0096jB6ke3DEBbn", "version": 1751118712, "format": "epub", "soldout": 0, "bookStatus": 1, "cover": "https://res.weread.qq.com/wrepub/CB_5Ct2PT2PHAJ56i76gp6Ax4ig_parsecover", "title": "The Psychology of Money: Timeless Lessons on Wealth, Greed, and Happiness", "author": "Morgan Housel", "coverBoxInfo": {"colorsPure": ["#93B0DA", "#98B8DD"]}}}, "reviews": {"reviews": [{"reviewId": "17408780_7NH5tB8Gc", "review": {"isPrivate": 1, "bookId": "CB_1bQ0TE0VY0096jB6ke3DEBbn", "content": "", "bookVersion": 1751118712, "type": 4, "star": 60, "reviewId": "17408780_7NH5tB8Gc", "userVid": 17408780, "topics": [], "createTime": 1703387283, "isDeepV": 1, "flag": 8, "newRatingLevel": 2, "isLike": 0, "isReposted": 0, "book": {"bookId": "CB_1bQ0TE0VY0096jB6ke3DEBbn", "format": "epub", "version": 1751118712, "soldout": 0, "bookStatus": 1, "type": 0,